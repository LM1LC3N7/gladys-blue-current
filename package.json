{
  "name": "gladys-blue-current",
  "version": "0.1.2",
  "private": true,
  "description": "Blue Current charge points (Netherlands, Belgium) for Gladys Assistant through the official Blue Current WebSocket API: status, power, current and voltage per phase, energy, duration and cost of the session; start, stop, block and reboot behind off-by-default options.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-blue-current.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
